{
  "seed": 2025,
  "data": {
    "source": "synthetic",
    "scenario": "data/generated/paper_scenario.npz",
    "base_stations_csv": "data/external/shanghai_base_stations.csv",
    "taxi_trajectories_csv": "data/external/shanghai_taxi_trajectories.csv",
    "alibaba_trace_csv": "data/external/alibaba_microservices.csv"
  },
  "network": {
    "esps": 3233,
    "controllers": 16,
    "clouds": 1,
    "candidate_paths": 3,
    "esp_cpu": [6.0, 10.0],
    "esp_memory_gb": [8.0, 16.0],
    "link_bandwidth_mbps": [1000.0, 2000.0],
    "link_delay_ms": [1.0, 5.0]
  },
  "traffic": {
    "taxis": 4328,
    "duration_s": 1.0,
    "decision_interval_ms": 10.0,
    "request_rate_s": [5.0, 300.0],
    "pareto_shape": 1.5,
    "mobility_speed": [0.0, 2.0]
  },
  "service": {
    "cpu": [0.1, 4.0],
    "memory_gb": [0.128, 8.0],
    "traffic_mbps": [1.0, 8.0],
    "lifetime_s": [1.0, 5.0],
    "sla_ms": 100.0
  },
  "objective": {
    "latency_weight": 0.5,
    "resource_weight": 0.5
  },
  "rag": {
    "database": "data/rag.sqlite",
    "top_k": 50,
    "decay_seconds": 86400,
    "initial_traces": 75000,
    "max_traces": 150000,
    "gat_layers": 3,
    "gat_heads": 8,
    "gat_head_dim": 64,
    "embedding_dim": 512
  },
  "llm": {
    "model": "Qwen/Qwen2-7B-Instruct",
    "dtype": "float16",
    "trainable_fraction": 0.3,
    "lora_rank": 16,
    "lora_alpha": 32,
    "candidate_plans": 5,
    "max_new_tokens": 4096,
    "edge_push_ms": 500.0,
    "prior_strength": 1.0,
    "offline_samples": 2048,
    "behavior_epochs": 10,
    "meta_rate": 0.1,
    "prompt": "prompts/cloud_planner.md",
    "adapter": "models/qwen_lora",
    "offline_data": "data/offline_samples.npz"
  },
  "ppo": {
    "actor_lr": 0.0003,
    "critic_lr": 0.001,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "rollout_steps": 2048,
    "minibatch_size": 256,
    "update_epochs": 10,
    "clip_ratio": 0.2,
    "value_coef": 0.5,
    "entropy_start": 0.01,
    "entropy_end": 0.001,
    "meta_steps": 5
  },
  "baseline": {
    "dqn_lr": 0.001,
    "dqn_replay_size": 2048,
    "dqn_batch_size": 256,
    "dqn_target_update": 100
  },
  "experiment": {
    "episodes": 4000,
    "monte_carlo_runs": 1000,
    "seeds": [2025],
    "methods": ["RAG-DRL", "DQN Scheduler", "DRP"],
    "latency_scales": [
      {"microservices": 26, "replicas": 3},
      {"microservices": 30, "replicas": 5},
      {"microservices": 33, "replicas": 6},
      {"microservices": 37, "replicas": 8}
    ],
    "utilization_scales": [
      {"microservices": 26, "replicas": 3},
      {"microservices": 28, "replicas": 4},
      {"microservices": 30, "replicas": 5},
      {"microservices": 32, "replicas": 5},
      {"microservices": 34, "replicas": 6},
      {"microservices": 37, "replicas": 8}
    ]
  },
  "paths": {
    "training_log": "logs/training.csv",
    "figure_data": "figures/data",
    "rag_drl_checkpoint": "models/rag_drl.pt",
    "dqn_checkpoint": "models/dqn.pt",
    "drp_checkpoint": "models/drp.json"
  }
}
